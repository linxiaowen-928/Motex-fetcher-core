{
  "name": "motex-fetcher-core",
  "version": "0.1.0",
  "description": "通用抓取框架核心（两阶段 index→crawl、调度/重试/断点、二进制下载、BFS 发现、可选管理服务）——各项目扩展接入",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fetcher": "./src/fetcher.ts",
    "./loader": "./src/loader.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "self-test": "node --experimental-strip-types src/cli.ts --self-test",
    "self-test-cordis": "node --experimental-strip-types src/cli.ts --cordis examples/selftest.cordis.yml"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "cheerio": "^1.0.0",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.10.1",
    "yaml": "^2.9.0"
  },
  "license": "MIT"
}
